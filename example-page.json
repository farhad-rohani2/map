}, 174286, "گلهای رضا", 0, 2786, "", 70, false, "پیش دبستانی غیر انتفاعی گلهای رضا نیشابور یکی از مدارس غیر انتفاعی استان خراسان رضوی است که در نیشابور واقع شده است. این مدرسه در نشانی  قرار دارد.\nبر اساس شاخص‌های رتبه‌بندی گاما، در نیشابور این مدرسه رتبه 6 و در استان خراسان رضوی رتبه 43 را کسب کرده است.\n پیش دبستانی غیر انتفاعی گلهای رضا نیشابور دارای تسهیلات آموزشی و علمی متنوعی است که برای دانش آموزان پیش دبستانی فراهم شده است. این آموزشگاه آمادگی دارد تا به طور مستمر به سوالات اولیاء گرامی دانش آموزان پاسخ دهد. برای تماس با مدرسه، می‌توانید از شماره تلفن --- یا ایمیل --- استفاده کنید. همچنین اطلاعات کامل‌تری درباره این مدرسه را می‌توانید از وبسایت مدرسه به نشانی --- به دست آورید.", "2024-06-30 16:03:06", [], "گلهای-رضا", "پیش دبستانی غیر انتفاعی گلهای رضا نیشابور", "پیش دبستانی  گلهای رضا یکی از مدارس غیر انتفاعی نیشابور در استان علوم تجربی است.", "مختلط","غیر انتفاعی", "نیشابور", "خراسان رضوی", "پیش دبستانی",{"area": 213, "state": 216, "total":218},{"rank": 214, "total": 215}, 6, 296,{"rank": 130, "total": 217}, 4518,{"rank": 84, "total": 219}, 62255,{"score": 196, "contribution": 221, "likes":225},{"teachers": 222, "students": 223, "popularity":224}, 16.35, 15.19, 12.62,{"num": 196, "like": 196, "dislike":196, "data": 226}, [227, 230, 233, 236,239],{"id": 228, "title": 229, "num":196, "like": 196, "dislike": 196,"userAnswer": 14}, 9327, "کلاسا و امکاناتش خوبه؟",{"id": 231, "title": 232, "num":196, "like": 196, "dislike": 196,"userAnswer": 14}, 9328, "معلم‌ها درس رو خوب یاد میدن؟",{"id": 234, "title": 235, "num":196, "like": 196, "dislike": 196,"userAnswer": 14}, 9330, "مدرسه امن و شاده؟",{"id": 237, "title": 238, "num":196, "like": 196, "dislike": 196,"userAnswer": 14}, 9333, "مکان ورزشی دارین؟",{"id": 240, "title": 241, "num":196, "like": 196, "dislike": 196,"userAnswer": 14}, 9334, "کلاس هنری، کامپیوتر یا مشاوره دارین؟", "10 تیر 1403",{"num": 196, "data": 244}, [],{"num": 196, "data": 246}, [], [],{"num": 196, "list": 249}, [], [251, 257, 263, 269, 275],{"